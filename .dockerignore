# ── Secrets / credential material — never in a build context ────────────
# (statwise/flutterwave_key is the live Flutterwave secret file; *_key and
# .env* catch any future key files and env dumps.)
statwise/flutterwave_key
**/*_key
**/.env*
.venv
**/.venv

# ── Large build outputs that must be produced inside the image ──────────
website/.next
website/out
website/node_modules
# Trained model artifacts (can be hundreds of MB; ai-scheduler rebuilds or
# fetches them at runtime via the ai_models volume — never COPY them in).
ai/models
# Expo/React Native local state + the web export (regenerated by the build).
statwise/.expo
statwise/dist
