ai/data/tennis/raw/
ai/data/basketball/raw/
ai/data/baseball/raw/
ai/data/volleyball/raw/

# Generated multi-sport data artefacts
ai/data/weather_by_match.csv
.github/scripts/package-lock.json

# Runtime state written on every run (noise in diffs)
ai/data/heartbeat.json
ai/data/odds_cache.json
