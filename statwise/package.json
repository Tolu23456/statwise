{
  "name": "statwise-app",
  "version": "1.0.0",
  "description": "StatWise - AI sports predictions. Native-first Expo Android app (expo-router) with a static web build, backed by Supabase.",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "BROWSER=none EXPO_NO_DEVTOOLS=1 node node_modules/.bin/expo start --web --port 5000 --clear",
    "start": "BROWSER=none EXPO_NO_DEVTOOLS=1 node node_modules/.bin/expo start --web --port 5000 --clear",
    "web": "BROWSER=none EXPO_NO_DEVTOOLS=1 node node_modules/.bin/expo start --web --port 5000",
    "web:bg": "bash scripts/start-web.sh",
    "web:stop": "bash scripts/stop-web.sh",
    "android": "expo start --android",
    "export:web": "expo export --platform web",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/metro-runtime": "^55.0.7",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@supabase/supabase-js": "^2.101.0",
    "@tanstack/react-query": "^5.95.2",
    "@types/react": "^19.2.14",
    "expo": "~55.0.32",
    "expo-clipboard": "~55.0.17",
    "expo-constants": "^55.0.9",
    "expo-device": "~55.0.0",
    "expo-font": "^55.0.4",
    "expo-haptics": "~55.0.18",
    "expo-image": "~55.0.11",
    "expo-image-picker": "~55.0.24",
    "expo-linking": "~55.0.17",
    "expo-notifications": "~55.0.0",
    "expo-router": "~55.0.18",
    "expo-secure-store": "~55.0.18",
    "expo-splash-screen": "~55.0.25",
    "expo-status-bar": "~55.0.6",
    "expo-web-browser": "~55.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-native": "0.83.10",
    "react-native-gesture-handler": "^2.30.1",
    "react-native-reanimated": "^4.2.1",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "^4.23.0",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.7.4",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "sports",
    "prediction",
    "ai",
    "android",
    "expo",
    "supabase"
  ],
  "author": "StatWise Team",
  "license": "MIT"
}
